[Unit]
Description=Screen Park Golf Service
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/screen_park_golf_service
ExecStart=/opt/screen_park_golf_service/deploy/wsl/start-screen-golf.sh
ExecStop=/opt/screen_park_golf_service/deploy/wsl/stop-screen-golf.sh
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
