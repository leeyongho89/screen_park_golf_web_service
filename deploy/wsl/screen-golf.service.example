[Unit]
Description=Screen Park Golf Service
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/user/app/screen_park_golf_web_service
ExecStart=/home/user/app/screen_park_golf_web_service/deploy/wsl/start-screen-golf.sh
ExecStop=/home/user/app/screen_park_golf_web_service/deploy/wsl/stop-screen-golf.sh
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
